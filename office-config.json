        { "name": "Account Executive", "role": "Works qualified prospects, runs pitches, negotiates and closes deals", "keywords": ["pitch", "demo", "proposal", "deal", "prospect", "negotiat", "contract", "lead", "outreach", "closing"] },
        { "name": "Customer Success", "role": "Onboarding, support, retention, upsell and cross-sell", "keywords": ["onboarding", "retention", "support", "upsell", "cross-sell", "crosssell", "renewal", "churn", "client", "customer", "faq"] }
