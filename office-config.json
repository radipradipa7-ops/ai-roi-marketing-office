        { "name": "Manager", "role": "Runs the content calendar, planning and workflows", "keywords": ["calendar", "plan", "schedule", "workflow", "brief", "roadmap", "timeline", "blueprint", "config", "settings", "claude.md", "readme"], "tools": ["Bash", "Task", "Agent", "TodoWrite", "mcp__*"] }
