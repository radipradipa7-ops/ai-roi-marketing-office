        { "name": "Analyst", "role": "Tracks performance and audience retention", "keywords": ["metric", "retention", "analytic", "performance", "kpi", "report", "stats", "insight", "screentime", "screen_time", "allocation", ".csv", ".xlsx"] }
      ]
    },
